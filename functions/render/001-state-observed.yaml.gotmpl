# code: language=yaml
#
# Extract composed resource readiness from observed state.
#

{{- $observedResources := $.observed.resources | default dict }}
{{- $readiness := dict }}

{{- range $key := list
  "distribution-namespace"
  "distribution-bucket"
  "distribution-bucket-pab"
  "distribution-bucket-encryption"
  "distribution-bucket-lifecycle"
  "distribution-service-account"
  "distribution-pod-identity"
}}
  {{- $entry := get $observedResources $key | default dict }}
  {{- $resource := $entry.resource | default dict }}
  {{- $status := $resource.status | default dict }}
  {{- $ready := false }}
  {{- range ($status.conditions | default list) }}
    {{- if and (eq .type "Ready") (eq .status "True") }}
      {{- $ready = true }}
    {{- end }}
  {{- end }}
  {{- $_ := set $readiness $key $ready }}
{{- end }}

{{- range $upstream := (($state.spec.effective.distribution | default dict).upstreams | default list) }}
  {{- range $key := list
    (printf "distribution-config-%s" $upstream.name)
    (printf "distribution-deployment-%s" $upstream.name)
    (printf "distribution-service-%s" $upstream.name)
    (printf "distribution-httproute-%s" $upstream.name)
    (printf "distribution-root-httproute-%s" $upstream.name)
    (printf "distribution-imageconfig-%s" $upstream.name)
  }}
    {{- $entry := get $observedResources $key | default dict }}
    {{- $resource := $entry.resource | default dict }}
    {{- $status := $resource.status | default dict }}
    {{- $ready := false }}
    {{- range ($status.conditions | default list) }}
      {{- if and (eq .type "Ready") (eq .status "True") }}
        {{- $ready = true }}
      {{- end }}
    {{- end }}
    {{- $_ := set $readiness $key $ready }}
  {{- end }}
{{- end }}

{{- $distributionBucketEntry := get $observedResources "distribution-bucket" | default dict }}
{{- $distributionBucketResource := $distributionBucketEntry.resource | default dict }}
{{- $distributionBucketStatus := $distributionBucketResource.status | default dict }}
{{- $distributionBucketAtProvider := $distributionBucketStatus.atProvider | default dict }}

{{- $distributionPodIdentityEntry := get $observedResources "distribution-pod-identity" | default dict }}
{{- $distributionPodIdentityResource := $distributionPodIdentityEntry.resource | default dict }}
{{- $distributionPodIdentityStatus := $distributionPodIdentityResource.status | default dict }}
{{- $distributionPodIdentity := $distributionPodIdentityStatus.podIdentity | default dict }}
{{- $distributionPodIdentityAssociation := $distributionPodIdentity.association | default dict }}

{{- $state = set $state "observed" (dict
  "raw" $observedResources
  "ready" $readiness
  "distribution" (dict
    "bucket" (dict
      "id" ($distributionBucketAtProvider.id | default "")
      "arn" ($distributionBucketAtProvider.arn | default "")
    )
    "podIdentity" (dict
      "associationId" ($distributionPodIdentityAssociation.id | default "")
      "roleArn" ($distributionPodIdentityAssociation.roleArn | default "")
    )
  )
) }}
