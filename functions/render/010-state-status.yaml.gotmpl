# code: language=yaml
#
# Compute XR status from desired and observed state.
#

{{- $cache := $state.registryCache }}
{{- $readyMap := $state.observed.ready | default dict }}

{{- $distributionReady := true }}
{{- $distributionUpstreams := list }}
{{- if $cache.distribution.render }}
  {{- if and $cache.distribution.renderNamespace (not (get $readyMap "distribution-namespace" | default false)) }}
    {{- $distributionReady = false }}
  {{- end }}
  {{- if $cache.distribution.renderBucket }}
    {{- range $key := list "distribution-bucket" "distribution-bucket-pab" "distribution-bucket-encryption" }}
      {{- if not (get $readyMap $key | default false) }}
        {{- $distributionReady = false }}
      {{- end }}
    {{- end }}
    {{- if and $cache.distribution.storage.lifecycle.enabled (not (get $readyMap "distribution-bucket-lifecycle" | default false)) }}
      {{- $distributionReady = false }}
    {{- end }}
  {{- end }}
  {{- if not (get $readyMap "distribution-service-account" | default false) }}
    {{- $distributionReady = false }}
  {{- end }}
  {{- if and $cache.distribution.renderPodIdentity (not (get $readyMap "distribution-pod-identity" | default false)) }}
    {{- $distributionReady = false }}
  {{- end }}
  {{- range $route := $cache.distribution.gateway.rootRoutes }}
    {{- if not (get $readyMap (printf "distribution-root-httproute-%s" $route.name) | default false) }}
      {{- $distributionReady = false }}
    {{- end }}
  {{- end }}
  {{- range $upstream := $cache.distribution.upstreams }}
    {{- $upstreamReady := true }}
    {{- range $key := list
      (printf "distribution-config-%s" $upstream.name)
      (printf "distribution-deployment-%s" $upstream.name)
      (printf "distribution-service-%s" $upstream.name)
    }}
      {{- if not (get $readyMap $key | default false) }}
        {{- $upstreamReady = false }}
      {{- end }}
    {{- end }}
    {{- if and $upstream.gateway.enabled (not (get $readyMap (printf "distribution-httproute-%s" $upstream.name) | default false)) }}
      {{- $upstreamReady = false }}
    {{- end }}
    {{- if and $upstream.rewrite.enabled (not (get $readyMap (printf "distribution-imageconfig-%s" $upstream.name) | default false)) }}
      {{- $upstreamReady = false }}
    {{- end }}
    {{- if not $upstreamReady }}
      {{- $distributionReady = false }}
    {{- end }}
    {{- $distributionUpstreams = append $distributionUpstreams (dict
      "name" $upstream.name
      "ready" $upstreamReady
      "sourceRegistry" $upstream.sourceRegistry
      "matchPrefix" $upstream.matchPrefix
      "remoteUrl" $upstream.remoteUrl
      "serviceName" $upstream.service.name
      "httpRouteName" $upstream.gateway.httpRouteName
      "gatewayHostname" $upstream.gateway.hostname
      "gatewayPathPrefix" $upstream.gateway.pathPrefix
      "rewritePrefix" $upstream.rewrite.prefix
    ) }}
  {{- end }}
{{- end }}

{{- $state = set $state "status" (dict
  "ready" $distributionReady
  "distribution" (dict
    "enabled" $cache.distribution.enabled
    "ready" $distributionReady
    "namespace" $cache.distribution.namespace
    "bucketName" $cache.distribution.storage.bucketName
    "upstreams" $distributionUpstreams
  )
) }}
