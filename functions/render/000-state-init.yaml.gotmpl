# code: language=yaml
#
# Initialize $state with spec defaults.
#

{{- $xr := getCompositeResource . }}
{{- $metadata := $xr.metadata | default dict }}
{{- $spec := $xr.spec | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "registry-cache" }}
{{- $accountId := $spec.accountId | default "" }}
{{- $region := $spec.region | default "" }}
{{- $clusterName := $spec.clusterName | default "" }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}

{{- $defaults := dict
  "hops.ops.com.ai/managed" "true"
  (printf "hops.ops.com.ai/%s" (lower $xr.kind)) $name
}}
{{- $labels := mergeOverwrite (dict) $defaults ($spec.labels | default dict) }}
{{- $tags := mergeOverwrite (dict) $defaults ($spec.tags | default dict) }}

# ==============================================================================
# Provider config refs
# ==============================================================================
{{- $providerConfigRefs := $spec.providerConfigRefs | default dict }}
{{- $awsProviderConfigSpec := $providerConfigRefs.aws | default dict }}
{{- $awsProviderConfigRef := dict
  "name" ($awsProviderConfigSpec.name | default "default")
  "kind" ($awsProviderConfigSpec.kind | default "ProviderConfig")
}}

{{- $kubernetesProviderConfigSpec := $providerConfigRefs.kubernetes | default dict }}
{{- $kubernetesProviderConfigRef := dict
  "name" ($kubernetesProviderConfigSpec.name | default $clusterName | default "default")
  "kind" ($kubernetesProviderConfigSpec.kind | default "ProviderConfig")
}}

# ==============================================================================
# Distribution proxy cache defaults
# ==============================================================================
{{- $distributionSpec := $spec.distribution | default dict }}
{{- $distributionEnabled := false }}
{{- if hasKey $distributionSpec "enabled" }}
  {{- $distributionEnabled = $distributionSpec.enabled }}
{{- end }}

{{- $distributionNamespace := $distributionSpec.namespace | default "crossplane-system" }}
{{- $distributionCreateNamespace := $distributionSpec.createNamespace | default false }}
{{- $distributionImagePullPolicy := $distributionSpec.imagePullPolicy | default "IfNotPresent" }}
{{- $distributionReplicas := $distributionSpec.replicas | default 1 }}

{{- $distributionServiceAccountSpec := $distributionSpec.serviceAccount | default dict }}
{{- $distributionServiceAccountName := $distributionServiceAccountSpec.name | default (printf "%s-distribution" $name) }}
{{- $distributionServiceAccountLabels := mergeOverwrite (dict) $labels ($distributionServiceAccountSpec.labels | default dict) }}

{{- $distributionPodIdentitySpec := $distributionSpec.podIdentity | default dict }}
{{- $distributionPodIdentityEnabled := true }}
{{- if hasKey $distributionPodIdentitySpec "enabled" }}
  {{- $distributionPodIdentityEnabled = $distributionPodIdentitySpec.enabled }}
{{- end }}

{{- $distributionStorageSpec := $distributionSpec.storage | default dict }}
{{- $defaultDistributionBucket := regexReplaceAll "[^a-z0-9-]+" (lower (printf "hops-%s-%s-%s-registry-cache" $accountId $region $name)) "-" }}
{{- $defaultDistributionBucket = trimAll "-" (trunc 63 $defaultDistributionBucket) }}
{{- $distributionBucketName := $distributionStorageSpec.bucketName | default $defaultDistributionBucket }}
{{- $distributionCreateBucket := true }}
{{- if hasKey $distributionStorageSpec "createBucket" }}
  {{- $distributionCreateBucket = $distributionStorageSpec.createBucket }}
{{- end }}
{{- $distributionRootPrefix := trimAll "/" ($distributionStorageSpec.rootPrefix | default "distribution") }}
{{- $distributionStorageEncrypt := true }}
{{- if hasKey $distributionStorageSpec "encrypt" }}
  {{- $distributionStorageEncrypt = $distributionStorageSpec.encrypt }}
{{- end }}
{{- $distributionStorageSecure := true }}
{{- if hasKey $distributionStorageSpec "secure" }}
  {{- $distributionStorageSecure = $distributionStorageSpec.secure }}
{{- end }}
{{- $distributionStorageV4Auth := true }}
{{- if hasKey $distributionStorageSpec "v4Auth" }}
  {{- $distributionStorageV4Auth = $distributionStorageSpec.v4Auth }}
{{- end }}
{{- $distributionStorageForcePathStyle := false }}
{{- if hasKey $distributionStorageSpec "forcePathStyle" }}
  {{- $distributionStorageForcePathStyle = $distributionStorageSpec.forcePathStyle }}
{{- end }}

{{- $distributionLifecycleSpec := $distributionStorageSpec.lifecycle | default dict }}
{{- $distributionLifecycleEnabled := true }}
{{- if hasKey $distributionLifecycleSpec "enabled" }}
  {{- $distributionLifecycleEnabled = $distributionLifecycleSpec.enabled }}
{{- end }}
{{- $distributionAbortMultipartDays := 7 }}
{{- if hasKey $distributionLifecycleSpec "abortIncompleteMultipartUploadDays" }}
  {{- $distributionAbortMultipartDays = $distributionLifecycleSpec.abortIncompleteMultipartUploadDays }}
{{- end }}

{{- $distributionGatewaySpec := $distributionSpec.gateway | default dict }}
{{- $distributionGatewayEnabled := false }}
{{- if hasKey $distributionGatewaySpec "enabled" }}
  {{- $distributionGatewayEnabled = $distributionGatewaySpec.enabled }}
{{- end }}
{{- $distributionGatewayRefSpec := $distributionGatewaySpec.gatewayRef | default dict }}
{{- $distributionGatewayRefSectionNames := $distributionGatewayRefSpec.sectionNames | default (list "https-apex") }}
{{- $distributionGatewayRef := dict
  "name" ($distributionGatewayRefSpec.name | default "platform")
  "namespace" ($distributionGatewayRefSpec.namespace | default "istio-ingress")
  "sectionNames" $distributionGatewayRefSectionNames
}}

# renovate: datasource=docker depName=library/registry registryUrl=https://index.docker.io
{{- $distributionImage := $distributionSpec.image | default "registry:3" }}

# ==============================================================================
# Initialize $state namespace
# ==============================================================================
{{- $state := dict
  "spec" (dict
    "raw" $spec
    "effective" (dict
      "name" $name
      "accountId" $accountId
      "region" $region
      "clusterName" $clusterName
      "managementPolicies" $managementPolicies
      "providerConfigRefs" (dict
        "aws" $awsProviderConfigRef
        "kubernetes" $kubernetesProviderConfigRef
      )
      "labels" $labels
      "tags" $tags
      "distribution" (dict
        "enabled" $distributionEnabled
        "namespace" $distributionNamespace
        "createNamespace" $distributionCreateNamespace
        "image" $distributionImage
        "imagePullPolicy" $distributionImagePullPolicy
        "replicas" $distributionReplicas
        "serviceAccount" (dict
          "name" $distributionServiceAccountName
          "labels" $distributionServiceAccountLabels
          "annotations" ($distributionServiceAccountSpec.annotations | default dict)
        )
        "podIdentity" (dict
          "enabled" $distributionPodIdentityEnabled
          "rolePrefix" ($distributionPodIdentitySpec.rolePrefix | default "")
          "roleNameOverride" ($distributionPodIdentitySpec.roleNameOverride | default "")
          "permissionsBoundaryArn" ($distributionPodIdentitySpec.permissionsBoundaryArn | default "")
        )
        "storage" (dict
          "bucketName" $distributionBucketName
          "createBucket" $distributionCreateBucket
          "rootPrefix" $distributionRootPrefix
          "encrypt" $distributionStorageEncrypt
          "secure" $distributionStorageSecure
          "v4Auth" $distributionStorageV4Auth
          "regionEndpoint" ($distributionStorageSpec.regionEndpoint | default "")
          "forcePathStyle" $distributionStorageForcePathStyle
          "lifecycle" (dict
            "enabled" $distributionLifecycleEnabled
            "abortIncompleteMultipartUploadDays" $distributionAbortMultipartDays
          )
        )
        "gateway" (dict
          "enabled" $distributionGatewayEnabled
          "hostname" ($distributionGatewaySpec.hostname | default "")
          "port" ($distributionGatewaySpec.port | default 443)
          "httpRouteAnnotations" ($distributionGatewaySpec.httpRouteAnnotations | default dict)
          "gatewayRef" $distributionGatewayRef
        )
        "upstreams" ($distributionSpec.upstreams | default list)
      )
    )
  )
  "observed" (dict)
  "registryCache" (dict)
  "status" (dict)
}}
