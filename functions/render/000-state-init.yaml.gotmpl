# code: language=yaml
#
# Initialize $state with spec defaults.
#

{{- $xr := getCompositeResource . }}
{{- $metadata := $xr.metadata | default dict }}
{{- $spec := $xr.spec | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "registry-cache" }}
{{- $accountId := $spec.accountId | default "" }}
{{- $region := $spec.region | default "" }}
{{- $clusterName := $spec.clusterName | default "" }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}
{{- $registryHost := printf "%s.dkr.ecr.%s.amazonaws.com" $accountId $region }}

{{- $defaults := dict
  "hops.ops.com.ai/managed" "true"
  (printf "hops.ops.com.ai/%s" (lower $xr.kind)) $name
}}
{{- $labels := merge (dict) $defaults ($spec.labels | default dict) }}
{{- $tags := merge (dict) $defaults ($spec.tags | default dict) }}

# ==============================================================================
# Provider config refs
# ==============================================================================
{{- $providerConfigRefs := $spec.providerConfigRefs | default dict }}
{{- $awsProviderConfigSpec := $providerConfigRefs.aws | default dict }}
{{- $awsProviderConfigRef := dict
  "name" ($awsProviderConfigSpec.name | default "default")
  "kind" ($awsProviderConfigSpec.kind | default "ProviderConfig")
}}

{{- $kubernetesProviderConfigSpec := $providerConfigRefs.kubernetes | default dict }}
{{- $kubernetesProviderConfigRef := dict
  "name" ($kubernetesProviderConfigSpec.name | default $clusterName | default "default")
  "kind" ($kubernetesProviderConfigSpec.kind | default "ProviderConfig")
}}

# ==============================================================================
# Pull-through defaults
# ==============================================================================
{{- $pullThroughSpec := $spec.pullThrough | default dict }}
{{- $pullThroughEnabled := false }}
{{- if hasKey $pullThroughSpec "enabled" }}
  {{- $pullThroughEnabled = $pullThroughSpec.enabled }}
{{- end }}

# ==============================================================================
# Mirror defaults
# ==============================================================================
{{- $mirrorSpec := $spec.mirror | default dict }}
{{- $mirrorEnabled := false }}
{{- if hasKey $mirrorSpec "enabled" }}
  {{- $mirrorEnabled = $mirrorSpec.enabled }}
{{- end }}

{{- $targetSpec := $mirrorSpec.target | default dict }}
{{- $defaultTargetPrefixes := dict
  "xpkg.crossplane.io" "xpkg-crossplane"
  "xpkg.upbound.io" "xpkg-upbound"
}}
{{- $targetPrefixes := merge (dict) $defaultTargetPrefixes ($targetSpec.prefixes | default dict) }}

{{- $discoverySpec := $mirrorSpec.discovery | default dict }}
{{- $crossplanePackagesSpec := $discoverySpec.crossplanePackages | default dict }}
{{- $crossplanePackagesEnabled := true }}
{{- if hasKey $crossplanePackagesSpec "enabled" }}
  {{- $crossplanePackagesEnabled = $crossplanePackagesSpec.enabled }}
{{- end }}

{{- $podIdentitySpec := $mirrorSpec.podIdentity | default dict }}
{{- $podIdentityEnabled := true }}
{{- if hasKey $podIdentitySpec "enabled" }}
  {{- $podIdentityEnabled = $podIdentitySpec.enabled }}
{{- end }}

{{- $regsyncSpec := $mirrorSpec.regsync | default dict }}
{{- $regsyncMissingOnly := true }}
{{- if hasKey $regsyncSpec "missingOnly" }}
  {{- $regsyncMissingOnly = $regsyncSpec.missingOnly }}
{{- end }}

{{- $startingDeadlineSeconds := "" }}
{{- $hasStartingDeadlineSeconds := false }}
{{- if hasKey $mirrorSpec "startingDeadlineSeconds" }}
  {{- $startingDeadlineSeconds = $mirrorSpec.startingDeadlineSeconds }}
  {{- $hasStartingDeadlineSeconds = true }}
{{- end }}
{{- $successfulJobsHistoryLimit := 1 }}
{{- if hasKey $mirrorSpec "successfulJobsHistoryLimit" }}
  {{- $successfulJobsHistoryLimit = $mirrorSpec.successfulJobsHistoryLimit }}
{{- end }}
{{- $failedJobsHistoryLimit := 3 }}
{{- if hasKey $mirrorSpec "failedJobsHistoryLimit" }}
  {{- $failedJobsHistoryLimit = $mirrorSpec.failedJobsHistoryLimit }}
{{- end }}
{{- $backoffLimit := 1 }}
{{- if hasKey $mirrorSpec "backoffLimit" }}
  {{- $backoffLimit = $mirrorSpec.backoffLimit }}
{{- end }}
{{- $activeDeadlineSeconds := 7200 }}
{{- if hasKey $mirrorSpec "activeDeadlineSeconds" }}
  {{- $activeDeadlineSeconds = $mirrorSpec.activeDeadlineSeconds }}
{{- end }}

{{- $serviceAccountSpec := $mirrorSpec.serviceAccount | default dict }}
{{- $serviceAccountName := $serviceAccountSpec.name | default (printf "%s-mirror" $name) }}
{{- $serviceAccountLabels := merge (dict) $labels ($serviceAccountSpec.labels | default dict) }}

# ==============================================================================
# Initialize $state namespace
# ==============================================================================
{{- $state := dict
  "spec" (dict
    "raw" $spec
    "effective" (dict
      "name" $name
      "accountId" $accountId
      "region" $region
      "clusterName" $clusterName
      "registryHost" $registryHost
      "managementPolicies" $managementPolicies
      "providerConfigRefs" (dict
        "aws" $awsProviderConfigRef
        "kubernetes" $kubernetesProviderConfigRef
      )
      "labels" $labels
      "tags" $tags
      "pullThrough" (dict
        "enabled" $pullThroughEnabled
        "rules" ($pullThroughSpec.rules | default list)
        "enhancedScanning" ($pullThroughSpec.enhancedScanning | default dict)
      )
      "mirror" (dict
        "enabled" $mirrorEnabled
        "namespace" ($mirrorSpec.namespace | default "crossplane-system")
        "createNamespace" ($mirrorSpec.createNamespace | default false)
        "schedule" ($mirrorSpec.schedule | default "0 */6 * * *")
        "suspend" ($mirrorSpec.suspend | default false)
        "tool" ($mirrorSpec.tool | default "regsync")
        "image" ($mirrorSpec.image | default "ghcr.io/hops-ops/registry-cache-mirror:latest")
        "imagePullPolicy" ($mirrorSpec.imagePullPolicy | default "IfNotPresent")
        "imagePullSecrets" ($mirrorSpec.imagePullSecrets | default list)
        "serviceAccount" (dict
          "name" $serviceAccountName
          "labels" $serviceAccountLabels
          "annotations" ($serviceAccountSpec.annotations | default dict)
        )
        "target" (dict
          "registry" ($targetSpec.registry | default $registryHost)
          "prefixes" $targetPrefixes
        )
        "discovery" (dict
          "crossplanePackages" (dict
            "enabled" $crossplanePackagesEnabled
            "mode" ($crossplanePackagesSpec.mode | default "repository")
            "registries" ($crossplanePackagesSpec.registries | default (list "xpkg.crossplane.io" "xpkg.upbound.io"))
            "namespaces" ($crossplanePackagesSpec.namespaces | default list)
          )
        )
        "repositories" ($mirrorSpec.repositories | default list)
        "tags" ($mirrorSpec.tags | default (dict "mode" "all"))
        "regsync" (dict
          "missingOnly" $regsyncMissingOnly
          "interval" ($regsyncSpec.interval | default "6h")
          "parallel" ($regsyncSpec.parallel | default 2)
          "logLevel" ($regsyncSpec.logLevel | default "INFO")
        )
        "podIdentity" (dict
          "enabled" $podIdentityEnabled
          "rolePrefix" ($podIdentitySpec.rolePrefix | default "")
          "roleNameOverride" ($podIdentitySpec.roleNameOverride | default "")
          "permissionsBoundaryArn" ($podIdentitySpec.permissionsBoundaryArn | default "")
        )
        "env" ($mirrorSpec.env | default list)
        "envFrom" ($mirrorSpec.envFrom | default list)
        "resources" ($mirrorSpec.resources | default dict)
        "podSecurityContext" ($mirrorSpec.podSecurityContext | default dict)
        "securityContext" ($mirrorSpec.securityContext | default dict)
        "nodeSelector" ($mirrorSpec.nodeSelector | default dict)
        "tolerations" ($mirrorSpec.tolerations | default list)
        "affinity" ($mirrorSpec.affinity | default dict)
        "concurrencyPolicy" ($mirrorSpec.concurrencyPolicy | default "Forbid")
        "startingDeadlineSeconds" $startingDeadlineSeconds
        "hasStartingDeadlineSeconds" $hasStartingDeadlineSeconds
        "successfulJobsHistoryLimit" $successfulJobsHistoryLimit
        "failedJobsHistoryLimit" $failedJobsHistoryLimit
        "backoffLimit" $backoffLimit
        "activeDeadlineSeconds" $activeDeadlineSeconds
      )
    )
  )
  "observed" (dict)
  "registryCache" (dict)
  "status" (dict)
}}
